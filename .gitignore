.idea/
dist/
__pycache__/
*.pyc
*.pyo
*.pyd
build/
sdist/
# 打包配置要进版本库，其它 .spec 是 pyinstaller 随手生成的
*.spec
!LitematicaViewer.spec
log.txt
error.log

# 3D 渲染时生成的临时数据，每次打开都会重写
viewer/payload.json
# 由 lang/source/*.json 自动编译出来的，不进版本库
lang/*/LC_MESSAGES/
# 开发自检用的截图和样例文件
shot*.png
testdata/
# macOS 图标的中间产物，由 macos/make_icns.py 生成
icon.iconset/
icon.icns

# 本地测试脚本（自检、生成样例、截图），只在本机用，不进版本库
local_tests/

# wrangler（上传 R2 时生成的缓存）、本地测试用的临时投影
.wrangler/
viewer/_tmp/
